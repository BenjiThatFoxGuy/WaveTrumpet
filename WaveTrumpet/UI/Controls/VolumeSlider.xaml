<UserControl x:Class="WaveTrumpet.UI.Controls.VolumeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="32">
  <Grid Background="Transparent">
    <Slider x:Name="SliderPart"
            Minimum="0"
            Maximum="100"
            Style="{StaticResource SliderPartStyle}"
            ValueChanged="OnSliderValueChanged"
            PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="OnSliderPreviewMouseLeftButtonUp"
            PreviewMouseMove="OnSliderPreviewMouseMove"
            PreviewMouseWheel="OnSliderPreviewMouseWheel" />
  </Grid>
</UserControl>
