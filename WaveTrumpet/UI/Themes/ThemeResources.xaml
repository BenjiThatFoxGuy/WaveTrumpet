<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ThemeFlyoutBackgroundBrush" Color="#FF202020" />
  <SolidColorBrush x:Key="ThemeFlyoutChromeBrush" Color="#FF2A2A2A" />
  <SolidColorBrush x:Key="ThemeFlyoutBorderBrush" Color="#FF3A3A3A" />
  <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FF5AA9FF" />
  <SolidColorBrush x:Key="ThemeTextBrush" Color="#FFF4F4F4" />
  <SolidColorBrush x:Key="ThemeSecondaryTextBrush" Color="#FFB5B5B5" />
  <SolidColorBrush x:Key="ThemeMutedBrush" Color="#FF666666" />
  <SolidColorBrush x:Key="ThemeSliderBackgroundBrush" Color="#FF3B3B3B" />

  <Style x:Key="FlyoutTitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="FlyoutBodyTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="FlyoutSecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryTextBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style x:Key="FlyoutButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ThemeFlyoutChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFlyoutBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FlyoutIconButtonStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ThemeFlyoutChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ThemeFlyoutBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource ThemeMutedBrush}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
