<Window x:Class="WaveTrumpet.UI.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveTrumpet Dialog"
        Width="420"
        Height="220"
        Background="{DynamicResource ThemeFlyoutBackgroundBrush}">
  <Grid Margin="24">
    <TextBlock Text="Dialog surface placeholder for future settings and prompts."
               Foreground="{DynamicResource ThemeTextBrush}"
               FontSize="16"
               TextWrapping="Wrap"
               VerticalAlignment="Center"
               HorizontalAlignment="Center" />
  </Grid>
</Window>
