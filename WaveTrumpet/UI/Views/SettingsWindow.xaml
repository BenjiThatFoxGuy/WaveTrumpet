<Window x:Class="WaveTrumpet.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveTrumpet Settings"
        Width="480"
        Height="280"
        Background="{DynamicResource ThemeFlyoutBackgroundBrush}">
  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Settings"
                 Foreground="{DynamicResource ThemeTextBrush}"
                 FontSize="18"
                 HorizontalAlignment="Center" />
      <TextBlock Text="This PoC keeps settings native-side but does not persist them yet."
                 Foreground="{DynamicResource ThemeSecondaryTextBrush}"
                 FontSize="14"
                 Margin="0,8,0,0"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
